# .env de AgendaLlena en el servidor compartido (/opt/agendallena/.env, chmod 600).
APP_NAME=AgendaLlena
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://agendallenaia.atiende.lat
APP_TIMEZONE=UTC

# nginx del host llega desde el gateway de la red `interna` del compose.
TRUSTED_PROXIES=172.30.83.1
PUERTO_LOCAL=8083

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# El mysql8 que ya existe. MYSQL_NETWORK: ver docs/despliegue-compartido.md.
MYSQL_NETWORK=
DB_CONNECTION=mysql
DB_HOST=mysql8
DB_PORT=3306
DB_DATABASE=agendallena
DB_USERNAME=agendallena
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Meta y Google: los mismos valores que .env.production.example.
META_APP_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
# El simulador NO va en producción.
META_SIMULADOR=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://agendallenaia.atiende.lat/api/v1/oauth/google/callback

# Copiar a backend.hcl (no se versiona) y correr:
#   terraform init -backend-config=backend.hcl
# El bucket se crea UNA vez a mano en el panel de Spaces, privado y con versionado.
bucket = "agendallena-tfstate"
key    = "produccion/terraform.tfstate"
region = "us-east-1" # requerido por el backend s3; Spaces lo ignora

endpoints = {
  s3 = "https://nyc3.digitaloceanspaces.com"
}

skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_s3_checksum            = true

# .env del droplet. Copiar a /opt/agendallena/.env y `chmod 600 .env`.
# Nunca se versiona con valores reales.

DOMAIN=agendallena.example.com
IMAGE_TAG=latest

APP_NAME=AgendaLlena
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://${DOMAIN}
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agendallena
DB_USERNAME=agendallena
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

# Meta Cloud API
META_APP_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://${DOMAIN}/api/v1/oauth/google/callback

# El simulador NO va en produccion: META_SIMULADOR, META_GRAPH_URL y
# GOOGLE_API_URL se dejan sin definir. Aunque alguien encienda META_SIMULADOR,
# SoloConSimulador corta las rutas /dev/* con APP_ENV=production.
